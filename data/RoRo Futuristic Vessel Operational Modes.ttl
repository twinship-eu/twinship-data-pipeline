# Operational modes of the futuristic vessel: per-genset EngineMode
# individuals, the vessel's DraftMode and TrimMode ordinal bins and its
# VesselSpeedBin individuals. These
# are vessel- and engine-specific, so they are instance data rather than
# shared individuals in the ontology's operational-modes module.
#
# PROVISIONAL DATA (November 2026), from the vessel's designers:
# - Engine modes: kW ranges per genset and mode. The 15 % sea margin is
#   included in the upper bounds, so the lower-bound variation is 0 kW. In
#   port the vessel is on shore power with both gensets off. Mode 1
#   (manoeuvring in port) overlaps modes 2 and 3 on purpose: manoeuvring can
#   need 3500 kW at 0 knots, so it is identified from the situation (in
#   port, thrusters in use), not from load.
# - Draft modes: reference drafts 6.5, 6.75 (design) and 7.3 m, with
#   boundaries halfway between them (6.625 and 7.025 m). The shallowest and
#   deepest modes are open-ended, so they have only one bound.
# - Trim modes: placeholders; trim ranges and sign convention to be
#   clarified.
# - Engine speed bins do not apply to this diesel-electric vessel (the
#   propellers are driven by electric motors); vessel speed bins in knots
#   (speed over ground) are used instead. Four bins with the designers'
#   reference speeds 6, 14, 15 and 18 knots and propeller speeds; their
#   bounds are omitted until the designers confirm them.
# Mode names are in skos:altLabel; rdfs:comment holds explanations.
# Genset RPM bounds are intentionally omitted: the gensets run at constant
# speed.
#
# The pipeline adds this file to the futuristic vessel's component graph
# (vessel_rdf_graph). IRIs follow the pipeline's scheme; FV-GN-1 and
# FV-GN-2 are the gensets created from the spreadsheet.

@prefix fv: <https://twin-ship.eu/individuals/futuristic-vessel/> .
@prefix tw: <https://twin-ship.eu/twinship#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# #################################################################
# #
# #    Individuals — Draft Mode
# #
# #################################################################

fv:DraftMode1 a owl:NamedIndividual, tw:DraftMode ;
    rdfs:label "Draft Mode 1" ;
    skos:altLabel "Shallow draft" ;
    rdfs:comment "Ordinal draft configuration index 1 (shallowest) for the futuristic vessel." ;
    tw:twDraftModeReferenceDraftInM 6.5 ;
    tw:twDraftModeUpperBoundInM 6.625 .

fv:DraftMode2 a owl:NamedIndividual, tw:DraftMode ;
    rdfs:label "Draft Mode 2" ;
    skos:altLabel "Design draft" ;
    rdfs:comment "Ordinal draft configuration index 2 (design draft) for the futuristic vessel." ;
    tw:twDraftModeReferenceDraftInM 6.75 ;
    tw:twDraftModeLowerBoundInM 6.625 ;
    tw:twDraftModeUpperBoundInM 7.025 .

fv:DraftMode3 a owl:NamedIndividual, tw:DraftMode ;
    rdfs:label "Draft Mode 3" ;
    skos:altLabel "Deep draft" ;
    rdfs:comment "Ordinal draft configuration index 3 (deepest) for the futuristic vessel." ;
    tw:twDraftModeReferenceDraftInM 7.3 ;
    tw:twDraftModeLowerBoundInM 7.025 .

[] a owl:AllDifferent ;
    owl:distinctMembers ( fv:DraftMode1 fv:DraftMode2 fv:DraftMode3 ) .

# #################################################################
# #
# #    Individuals — Trim Mode
# #
# #################################################################

fv:TrimMode1 a owl:NamedIndividual, tw:TrimMode ;
    rdfs:label "Trim Mode 1" ;
    skos:altLabel "Bow trim" ;
    rdfs:comment "Ordinal trim configuration index 1 (lowest trim value) for the futuristic vessel. May represent a bow-trim-like condition." .

fv:TrimMode2 a owl:NamedIndividual, tw:TrimMode ;
    rdfs:label "Trim Mode 2" ;
    skos:altLabel "Even keel" ;
    rdfs:comment "Ordinal trim configuration index 2 (intermediate trim value) for the futuristic vessel. May represent an even-keel-like condition." .

fv:TrimMode3 a owl:NamedIndividual, tw:TrimMode ;
    rdfs:label "Trim Mode 3" ;
    skos:altLabel "Stern trim" ;
    rdfs:comment "Ordinal trim configuration index 3 (highest trim value) for the futuristic vessel. May represent a stern-trim-like condition." .

[] a owl:AllDifferent ;
    owl:distinctMembers ( fv:TrimMode1 fv:TrimMode2 fv:TrimMode3 ) .

# #################################################################
# #
# #    Individuals — Vessel Speed Bin
# #
# #################################################################

fv:VesselSpeedBin1 a owl:NamedIndividual, tw:VesselSpeedBin ;
    rdfs:label "Vessel Speed Bin 1" ;
    skos:altLabel "6 knots" ;
    rdfs:comment "Lowest vessel speed bin of the futuristic vessel. Bounds to be confirmed." ;
    tw:hasSpeedReference tw:SOG ;
    tw:twSpeedValueInKnots 6.0 ;
    tw:twSpeedBinPropellerSpeedInRevPerMin 60.0 .

fv:VesselSpeedBin2 a owl:NamedIndividual, tw:VesselSpeedBin ;
    rdfs:label "Vessel Speed Bin 2" ;
    skos:altLabel "14 knots" ;
    rdfs:comment "Vessel speed bin 2 of the futuristic vessel. Bounds to be confirmed." ;
    tw:hasSpeedReference tw:SOG ;
    tw:twSpeedValueInKnots 14.0 ;
    tw:twSpeedBinPropellerSpeedInRevPerMin 85.0 .

fv:VesselSpeedBin3 a owl:NamedIndividual, tw:VesselSpeedBin ;
    rdfs:label "Vessel Speed Bin 3" ;
    skos:altLabel "ECO speed, 15 knots" ;
    rdfs:comment "Vessel speed bin 3 of the futuristic vessel. Bounds to be confirmed." ;
    tw:hasSpeedReference tw:SOG ;
    tw:twSpeedValueInKnots 15.0 ;
    tw:twSpeedBinPropellerSpeedInRevPerMin 92.0 .

fv:VesselSpeedBin4 a owl:NamedIndividual, tw:VesselSpeedBin ;
    rdfs:label "Vessel Speed Bin 4" ;
    skos:altLabel "Design speed, 18 knots" ;
    rdfs:comment "Highest vessel speed bin of the futuristic vessel. Propeller speed 111-115 rev/min according to the designers; no single value is given. Bounds to be confirmed." ;
    tw:hasSpeedReference tw:SOG ;
    tw:twSpeedValueInKnots 18.0 .

[] a owl:AllDifferent ;
    owl:distinctMembers ( fv:VesselSpeedBin1 fv:VesselSpeedBin2 fv:VesselSpeedBin3 fv:VesselSpeedBin4 ) .

# #################################################################
# #
# #    Engine Modes — per genset
# #
# #    Provisional values; see the header.
# #
# #################################################################

fv:FV-GN-1 tw:twEngineModeCount 4 ;
    tw:hasEngineMode fv:FV-GN-1-EngineMode1,
        fv:FV-GN-1-EngineMode2,
        fv:FV-GN-1-EngineMode3,
        fv:FV-GN-1-EngineMode4 .

fv:FV-GN-2 tw:twEngineModeCount 4 ;
    tw:hasEngineMode fv:FV-GN-2-EngineMode1,
        fv:FV-GN-2-EngineMode2,
        fv:FV-GN-2-EngineMode3,
        fv:FV-GN-2-EngineMode4 .

fv:FV-GN-1-EngineMode1 a owl:NamedIndividual, tw:EngineMode ;
    rdfs:label "Genset 1 Engine Mode 1" ;
    skos:altLabel "Manoeuvring in port" ;
    rdfs:comment "With propellers and thrusters at variable load." ;
    tw:twEngineModeLowerBoundInKW 1200.0 ;
    tw:twEngineModeLowerBoundVariationInKW 0.0 ;
    tw:twEngineModeUpperBoundInKW 3500.0 .

fv:FV-GN-1-EngineMode2 a owl:NamedIndividual, tw:EngineMode ;
    rdfs:label "Genset 1 Engine Mode 2" ;
    skos:altLabel "6 knots" ;
    rdfs:comment "Only genset 1 runs at 6 knots." ;
    tw:twEngineModeLowerBoundInKW 1600.0 ;
    tw:twEngineModeLowerBoundVariationInKW 0.0 ;
    tw:twEngineModeUpperBoundInKW 1800.0 .

fv:FV-GN-1-EngineMode3 a owl:NamedIndividual, tw:EngineMode ;
    rdfs:label "Genset 1 Engine Mode 3" ;
    skos:altLabel "ECO speed, 15 knots" ;
    tw:twEngineModeLowerBoundInKW 3100.0 ;
    tw:twEngineModeLowerBoundVariationInKW 0.0 ;
    tw:twEngineModeUpperBoundInKW 3500.0 .

fv:FV-GN-1-EngineMode4 a owl:NamedIndividual, tw:EngineMode ;
    rdfs:label "Genset 1 Engine Mode 4" ;
    skos:altLabel "Design speed, 18 knots" ;
    tw:twEngineModeLowerBoundInKW 5200.0 ;
    tw:twEngineModeLowerBoundVariationInKW 0.0 ;
    tw:twEngineModeUpperBoundInKW 5800.0 .

fv:FV-GN-2-EngineMode1 a owl:NamedIndividual, tw:EngineMode ;
    rdfs:label "Genset 2 Engine Mode 1" ;
    skos:altLabel "Manoeuvring in port" ;
    rdfs:comment "With propellers and thrusters at variable load." ;
    tw:twEngineModeLowerBoundInKW 1200.0 ;
    tw:twEngineModeLowerBoundVariationInKW 0.0 ;
    tw:twEngineModeUpperBoundInKW 3500.0 .

fv:FV-GN-2-EngineMode2 a owl:NamedIndividual, tw:EngineMode ;
    rdfs:label "Genset 2 Engine Mode 2" ;
    skos:altLabel "6 knots" ;
    rdfs:comment "Genset 2 is not running (0 kW); only genset 1 runs at 6 knots." ;
    tw:twEngineModeLowerBoundInKW 0.0 ;
    tw:twEngineModeLowerBoundVariationInKW 0.0 ;
    tw:twEngineModeUpperBoundInKW 0.0 .

fv:FV-GN-2-EngineMode3 a owl:NamedIndividual, tw:EngineMode ;
    rdfs:label "Genset 2 Engine Mode 3" ;
    skos:altLabel "ECO speed, 15 knots" ;
    tw:twEngineModeLowerBoundInKW 3100.0 ;
    tw:twEngineModeLowerBoundVariationInKW 0.0 ;
    tw:twEngineModeUpperBoundInKW 3500.0 .

fv:FV-GN-2-EngineMode4 a owl:NamedIndividual, tw:EngineMode ;
    rdfs:label "Genset 2 Engine Mode 4" ;
    skos:altLabel "Design speed, 18 knots" ;
    tw:twEngineModeLowerBoundInKW 5200.0 ;
    tw:twEngineModeLowerBoundVariationInKW 0.0 ;
    tw:twEngineModeUpperBoundInKW 5800.0 .

[] a owl:AllDifferent ;
    owl:distinctMembers (
        fv:FV-GN-1-EngineMode1 fv:FV-GN-1-EngineMode2 fv:FV-GN-1-EngineMode3 fv:FV-GN-1-EngineMode4
        fv:FV-GN-2-EngineMode1 fv:FV-GN-2-EngineMode2 fv:FV-GN-2-EngineMode3 fv:FV-GN-2-EngineMode4
    ) .
