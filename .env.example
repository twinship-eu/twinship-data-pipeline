# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored; this file is the tracked template
# listing every variable the stack needs.
#
# Every variable below has a "local-dev-*" fallback baked into
# docker-compose.yml, so the stack also runs without a .env file at all.
# Those fallbacks are fine for a disposable local setup, but should always
# be overridden (via .env) for anything shared or persistent.

# --- Keycloak admin bootstrap account -----------------------------------
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# --- OIDC client secret for the Dagster pipeline's service account ------
# Must match the "dagster-pipeline" client secret imported into Keycloak
# (keycloak/twinship-realm.json.template) and the KEYCLOAK_CLIENT_SECRET
# the pipeline uses to request tokens.
KEYCLOAK_CLIENT_SECRET=change-me

# --- Demo per-vessel user passwords imported into the Keycloak realm ----
# These are local/demo accounts, one per vessel repository, used to
# demonstrate GraphDB's role-based repository access.
KEYCLOAK_GRIMALDI_RORO_PASSWORD=change-me
KEYCLOAK_STENA_ROPAX_PASSWORD=change-me
KEYCLOAK_STENA_TANKER_PASSWORD=change-me
KEYCLOAK_FUTURISTIC_VESSEL_PASSWORD=change-me

# --- GraphDB OpenID Connect settings -------------------------------------
# Must match the issuer Keycloak presents in the "iss" claim of its JWTs,
# i.e. <KEYCLOAK_SERVER_URL>/realms/<KEYCLOAK_REALM>. For the default local
# setup in docker-compose.yml, that's:
GRAPHDB_OIDC_ISSUER=http://keycloak:8080/realms/twinship

# --- Internal service URLs (Docker-network hostnames, not host ports) ---
# How the Dagster pipeline reaches GraphDB and Keycloak over the Docker
# network. Change these only if you rename the services in docker-compose.yml.
GRAPHDB_BASE_URL=http://graphdb:7200
KEYCLOAK_SERVER_URL=http://keycloak:8080

# --- Host ports -----------------------------------------------------------
# Published host-side ports for the services exposed outside Docker. Change
# these if the defaults are already in use on your machine.
KEYCLOAK_PORT=8080
GRAPHDB_PORT=7200
DAGSTER_WEBSERVER_PORT=3000

# --- Vessel input data -------------------------------------------------------
# Folder to read vessel input files from. Defaults to data/ when unset or
# empty. Absolute, or relative to the repository root. Read by
# `uv run dagster dev`; not passed into the Docker containers.
TWINSHIP_VESSEL_DATA_DIR=
