# syntax=docker/dockerfile:1
# Dagster webserver and daemon image
FROM python:3.11-slim

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

WORKDIR /app

# Put the venv on PATH so dagster commands are directly executable
ENV PATH="/app/.venv/bin:$PATH"

# Copy dependency files
COPY pyproject.toml uv.lock README.md ./

# Install dependencies (including dagster-webserver)
RUN uv sync --frozen --no-dev

# Copy application code (needed for module resolution)
COPY twinship_harmonisation/ ./twinship_harmonisation/
COPY dagster_pipeline/ ./dagster_pipeline/

# Copy dagster configuration (rename for Docker)
COPY dagster-docker.yaml dagster.yaml
COPY workspace.yaml ./

# The entrypoint will be overridden by docker-compose
CMD ["uv", "run", "dagster-webserver", "-h", "0.0.0.0", "-p", "3000", "-w", "workspace.yaml"]
