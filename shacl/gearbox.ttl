@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tws: <https://twin-ship.eu/twinship#> .
@prefix ido: <http://rds.posccaesar.org/ontology/lis14/rdl/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Shape for Gearbox systems (all subtypes)
tws:GearboxShape a sh:NodeShape ;
    sh:targetClass tws:DirectDrive, tws:Reduction, tws:SingleSpeed, tws:TISO, tws:PTO ;
    sh:property [
        sh:path ido:partOf ;
        sh:minCount 1 ;
        sh:class tws:VesselSystem ;
        sh:message "Gearbox must be part of a vessel" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Gearbox should have at most one label" ;
    ] ;
    sh:property [
        sh:path tws:twGearboxRatio ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Gearbox ratio must be a string" ;
    ] ;
    sh:property [
        sh:path tws:twGearboxEfficiency ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1 ;
        sh:message "Gearbox efficiency must be between 0 and 1" ;
    ] ;
    sh:property [
        sh:path tws:twGearboxShaftGenerator ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:in (0 1) ;
        sh:message "Shaft generator flag must be 0 or 1" ;
    ] .
