@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tws: <https://twin-ship.eu/twinship#> .
@prefix ido: <http://rds.posccaesar.org/ontology/lis14/rdl/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Shape for BidirectionalConverterSystem (DC Bus Converter)
tws:BidirectionalConverterSystemShape a sh:NodeShape ;
    sh:targetClass tws:BidirectionalConverterSystem ;
    sh:property [
        sh:path ido:partOf ;
        sh:minCount 1 ;
        sh:class tws:VesselSystem ;
        sh:message "DC bus converter must be part of a vessel" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path tws:twDCBNominalVoltage ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "DCB nominal voltage must be a number" ;
    ] .
