@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tws: <https://twin-ship.eu/twinship#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Shape for fuel consumption relationships
tws:FuelConsumerShape a sh:NodeShape ;
    sh:targetSubjectsOf tws:consume ;
    sh:property [
        sh:path tws:consume ;
        sh:minCount 1 ;
        sh:class tws:Fuel ;
        sh:message "consume property must reference a Fuel individual" ;
    ] .

# Shape for Fuel individuals
tws:FuelShape a sh:NodeShape ;
    sh:targetClass tws:Fuel ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Fuel must have exactly one label" ;
    ] ;
    sh:property [
        sh:path tws:twFuelDensityGrav15DegCKgPerLitre ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:minExclusive 0 ;
        sh:message "Fuel density must be a positive number" ;
    ] .
