@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tws: <https://twin-ship.eu/twinship#> .
@prefix ido: <http://rds.posccaesar.org/ontology/lis14/rdl/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Shape for GenSetSystem (diesel-electric generator set)
tws:GenSetSystemShape a sh:NodeShape ;
    sh:targetClass tws:GenSetSystem ;
    sh:property [
        sh:path ido:partOf ;
        sh:minCount 1 ;
        sh:class tws:VesselSystem ;
        sh:message "Genset must be part of a vessel" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Genset should have at most one label" ;
    ] ;
    sh:property [
        sh:path tws:twShaftPowerMaxInKW ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Shaft power must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twGeneratorVoltageInV ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Generator voltage must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twElectricalEfficiencyPercentage ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Electrical efficiency must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twGeneratorFrequency ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Generator frequency must be a number" ;
    ] ;
    sh:property [
        sh:path tws:consume ;
        sh:class tws:Fuel ;
        sh:message "Genset consume property must reference a Fuel individual" ;
    ] .
