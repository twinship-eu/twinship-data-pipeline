@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tws: <https://twin-ship.eu/twinship#> .
@prefix ido: <http://rds.posccaesar.org/ontology/lis14/rdl/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Shape for MainEngineSystem
tws:MainEngineSystemShape a sh:NodeShape ;
    sh:targetClass tws:MainEngineSystem ;
    sh:property [
        sh:path ido:partOf ;
        sh:minCount 1 ;
        sh:class tws:VesselSystem ;
        sh:message "Main engine must be part of a vessel" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Main engine should have at most one label" ;
    ] ;
    sh:property [
        sh:path tws:twShaftTorqueMaxInKnm ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Shaft torque must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twShaftSpeedMaxInRevPerMin ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Shaft speed must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twShaftPowerMaxInKW ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Shaft power must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twFlowrateMaxInKgPerHr ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Flowrate must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twFuelFlowTemperatureMaxInDegC ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Fuel flow temperature must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twInletAirPressureMaxInHPa ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Inlet air pressure must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twInletAirTemperatureMaxInDegC ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Inlet air temperature must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twMeCoolingWaterTemperatureMaxInDegC ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "ME cooling water temperature must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twLtCoolingSeawater1TemperatureMaxInDegC ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "LT cooling seawater 1 temperature must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twLtCoolingSeawater2TemperatureMaxInDegC ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "LT cooling seawater 2 temperature must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twScavengerAirRecTemperatureMaxInDegC ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Scavenger air receiver temperature must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twCommonDOMode ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:in (-1 0 1) ;
        sh:message "Common DO mode must be -1 (missing), 0 (off), or 1 (on)" ;
    ] ;
    sh:property [
        sh:path tws:twCommonFuelMode ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:in (-1 0 1) ;
        sh:message "Common fuel mode must be -1 (missing), 0 (off), or 1 (on)" ;
    ] ;
    sh:property [
        sh:path tws:twFuelConsumptionTotalInMT ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Fuel consumption must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twPowerPropulsionTotalInKw ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Propulsion power must be a number" ;
    ] ;
    sh:property [
        sh:path tws:consume ;
        sh:class tws:Fuel ;
        sh:message "Main engine consume property must reference a Fuel individual" ;
    ] .
