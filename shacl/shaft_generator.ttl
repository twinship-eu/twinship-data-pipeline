@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tws: <https://twin-ship.eu/twinship#> .
@prefix ido: <http://rds.posccaesar.org/ontology/lis14/rdl/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Shape for ShaftGeneratorSystem
tws:ShaftGeneratorSystemShape a sh:NodeShape ;
    sh:targetClass tws:ShaftGeneratorSystem ;
    sh:property [
        sh:path ido:partOf ;
        sh:minCount 1 ;
        sh:class tws:VesselSystem ;
        sh:message "Shaft generator must be part of a vessel" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Shaft generator should have at most one label" ;
    ] ;
    sh:property [
        sh:path tws:twShaftGeneratorPowerMaxInKW ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Shaft generator power must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twShaftGeneratorSpeedMaxInRevPerMin ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Shaft generator speed must be a number" ;
    ] .
