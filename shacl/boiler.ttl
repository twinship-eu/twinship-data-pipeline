@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tws: <https://twin-ship.eu/twinship#> .
@prefix ido: <http://rds.posccaesar.org/ontology/lis14/rdl/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Shape for Boiler
tws:BoilerShape a sh:NodeShape ;
    sh:targetClass tws:Boiler ;
    sh:property [
        sh:path ido:partOf ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:class tws:VesselSystem ;
        sh:message "Boiler partOf must reference a VesselSystem" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Boiler should have at most one label" ;
    ] ;
    sh:property [
        sh:path tws:twBoilerPowerMaxInKW ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Boiler power must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twBoilerSpeedMaxInRevPerMin ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Boiler speed must be a number" ;
    ] ;
    sh:property [
        sh:path tws:consume ;
        sh:class tws:Fuel ;
        sh:message "Boiler consume property must reference a Fuel individual" ;
    ] .
