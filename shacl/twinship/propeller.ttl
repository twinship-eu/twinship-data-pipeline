@prefix ido: <http://rds.posccaesar.org/ontology/lis14/rdl/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tws: <https://twin-ship.eu/twinship#> .
@prefix twsh: <https://twin-ship.eu/twinship/shapes#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Shape for Propellers (CPP and FPP subtypes)
twsh:PropellerShape a sh:NodeShape ;
    sh:targetClass tws:PropellerSystem ;
    sh:property [
        sh:path ido:partOf ;
        sh:qualifiedValueShape [ sh:class tws:VesselSystem ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Propeller must be part of a vessel" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:uniqueLang true ;
        sh:message "Propeller label must be a string or language-tagged string, at most one per language" ;
    ] ;
    sh:property [
        sh:path tws:twPropellerDiameterMm ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Propeller diameter must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twPropellerBlades ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:message "Propeller blades must be a single positive integer" ;
    ] ;
    sh:property [
        sh:path tws:twPropellerPitchDiameterRatio ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Pitch/diameter ratio must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twPropellerPitchMaxInPercentage ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Pitch max percentage must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twPropellerExpandedAreaRatioPercentage ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Expanded area ratio must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twPropellerHubRatio ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Hub ratio must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twPropellerSkewAngleDegree ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Skew angle must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twPropellerEfficiency ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Propeller efficiency must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twRudderAngleDegree ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Rudder angle must be a single number" ;
    ] .
