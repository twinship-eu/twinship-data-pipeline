@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tws: <https://twin-ship.eu/twinship#> .
@prefix twsh: <https://twin-ship.eu/twinship/shapes#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Shape for fuel consumption relationships
twsh:FuelConsumerShape a sh:NodeShape ;
    sh:targetSubjectsOf tws:consume ;
    sh:property [
        sh:path tws:consume ;
        sh:minCount 1 ;
        sh:class tws:Fuel ;
        sh:message "consume property must reference a Fuel individual" ;
    ] .

# Shape for Fuel individuals
twsh:FuelShape a sh:NodeShape ;
    sh:targetClass tws:Fuel ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:uniqueLang true ;
        sh:message "Fuel must have a label (string or language-tagged string), at most one per language" ;
    ] ;
    sh:property [
        sh:path tws:twFuelDensityGrav15DegCKgPerLitre ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:minExclusive 0 ;
        sh:message "Fuel density must be a single positive number" ;
    ] .
