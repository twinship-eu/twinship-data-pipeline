@prefix ido: <http://rds.posccaesar.org/ontology/lis14/rdl/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tws: <https://twin-ship.eu/twinship#> .
@prefix twsh: <https://twin-ship.eu/twinship/shapes#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Shape for MainEngineSystem
twsh:MainEngineSystemShape a sh:NodeShape ;
    sh:targetClass tws:MainEngineSystem ;
    sh:property [
        sh:path ido:partOf ;
        sh:qualifiedValueShape [ sh:class tws:VesselSystem ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Main engine must be part of a vessel" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:uniqueLang true ;
        sh:message "Main engine label must be a string or language-tagged string, at most one per language" ;
    ] ;
    sh:property [
        sh:path tws:twShaftTorqueMaxInKnm ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Shaft torque must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twShaftSpeedMaxInRevPerMin ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Shaft speed must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twShaftPowerMaxInKW ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Shaft power must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twFlowrateMaxInKgPerHr ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Flowrate must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twFuelFlowTemperatureMaxInDegC ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Fuel flow temperature must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twInletAirPressureMaxInHPa ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Inlet air pressure must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twInletAirTemperatureMaxInDegC ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Inlet air temperature must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twMeCoolingWaterTemperatureMaxInDegC ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "ME cooling water temperature must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twLtCoolingSeawater1TemperatureMaxInDegC ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "LT cooling seawater 1 temperature must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twLtCoolingSeawater2TemperatureMaxInDegC ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "LT cooling seawater 2 temperature must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twScavengerAirRecTemperatureMaxInDegC ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Scavenger air receiver temperature must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twCommonDOMode ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:in (0 1) ;
        sh:message "Common DO mode must be 0 (off) or 1 (on)" ;
    ] ;
    sh:property [
        sh:path tws:twCommonFuelMode ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:in (0 1) ;
        sh:message "Common fuel mode must be 0 (off) or 1 (on)" ;
    ] ;
    sh:property [
        sh:path tws:twFuelConsumptionTotalInMT ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Fuel consumption must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twPowerPropulsionTotalInKw ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Propulsion power must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:consume ;
        sh:class tws:Fuel ;
        sh:message "Main engine consume property must reference a Fuel individual" ;
    ] .
