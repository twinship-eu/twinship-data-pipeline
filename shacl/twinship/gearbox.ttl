@prefix ido: <http://rds.posccaesar.org/ontology/lis14/rdl/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tws: <https://twin-ship.eu/twinship#> .
@prefix twsh: <https://twin-ship.eu/twinship/shapes#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Shape for Gearbox systems (all subtypes)
twsh:GearboxShape a sh:NodeShape ;
    sh:targetClass tws:GearboxSystem ;
    sh:property [
        sh:path ido:partOf ;
        sh:qualifiedValueShape [ sh:class tws:VesselSystem ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Gearbox must be part of a vessel" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:uniqueLang true ;
        sh:message "Gearbox label must be a string or language-tagged string, at most one per language" ;
    ] ;
    sh:property [
        sh:path tws:twGearboxRatio ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Gearbox ratio must be a single string" ;
    ] ;
    sh:property [
        sh:path tws:twGearboxEfficiency ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Gearbox efficiency must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twGearboxShaftGenerator ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:in (0 1) ;
        sh:message "Shaft generator flag must be 0 (no) or 1 (yes)" ;
    ] .
