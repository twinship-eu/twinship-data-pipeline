@prefix ido: <http://rds.posccaesar.org/ontology/lis14/rdl/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tws: <https://twin-ship.eu/twinship#> .
@prefix twsh: <https://twin-ship.eu/twinship/shapes#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Shape for GenSetSystem (diesel-electric generator set)
twsh:GenSetSystemShape a sh:NodeShape ;
    sh:targetClass tws:GenSetSystem ;
    sh:property [
        sh:path ido:partOf ;
        sh:qualifiedValueShape [ sh:class tws:VesselSystem ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Genset must be part of a vessel" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:uniqueLang true ;
        sh:message "Genset label must be a string or language-tagged string, at most one per language" ;
    ] ;
    sh:property [
        sh:path tws:twShaftPowerMaxInKW ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Shaft power must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twGeneratorVoltageInV ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Generator voltage must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twElectricalEfficiencyPercentage ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Electrical efficiency must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twGeneratorFrequency ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Generator frequency must be a single number" ;
    ] ;
    sh:property [
        sh:path tws:twCommonFuelMode ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:in (0 1) ;
        sh:message "Common fuel mode must be 0 (off) or 1 (on)" ;
    ] ;
    sh:property [
        sh:path tws:consume ;
        sh:class tws:Fuel ;
        sh:message "Genset consume property must reference a Fuel individual" ;
    ] .
