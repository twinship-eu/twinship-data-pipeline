@prefix ido: <http://rds.posccaesar.org/ontology/lis14/rdl/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tws: <https://twin-ship.eu/twinship#> .
@prefix twsh: <https://twin-ship.eu/twinship/shapes#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Shape for GateRudder
twsh:GateRudderShape a sh:NodeShape ;
    sh:targetClass tws:GateRudder ;
    sh:property [
        sh:path ido:partOf ;
        sh:qualifiedValueShape [ sh:class tws:VesselSystem ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Gate rudder must be part of a vessel" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:uniqueLang true ;
        sh:message "Gate rudder label must be a string or language-tagged string, at most one per language" ;
    ] .

# Shape for BowThruster
twsh:BowThrusterShape a sh:NodeShape ;
    sh:targetClass tws:BowThruster ;
    sh:property [
        sh:path ido:partOf ;
        sh:qualifiedValueShape [ sh:class tws:VesselSystem ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Bow thruster must be part of a vessel" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:uniqueLang true ;
        sh:message "Bow thruster label must be a string or language-tagged string, at most one per language" ;
    ] ;
    sh:property [
        sh:path tws:twBowThrusterPowerMaxInKW ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Bow thruster power must be a single number" ;
    ] .

# Shape for WindAssistedPropulsionSystem (WASP)
twsh:WindAssistedPropulsionSystemShape a sh:NodeShape ;
    sh:targetClass tws:WindAssistedPropulsionSystem ;
    sh:property [
        sh:path ido:partOf ;
        sh:qualifiedValueShape [ sh:class tws:VesselSystem ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "WASP must be part of a vessel" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:uniqueLang true ;
        sh:message "WASP label must be a string or language-tagged string, at most one per language" ;
    ] .

# Shape for AirLubricationSystem (ALS)
twsh:AirLubricationSystemShape a sh:NodeShape ;
    sh:targetClass tws:AirLubricationSystem ;
    sh:property [
        sh:path ido:partOf ;
        sh:qualifiedValueShape [ sh:class tws:VesselSystem ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "ALS must be part of a vessel" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:uniqueLang true ;
        sh:message "ALS label must be a string or language-tagged string, at most one per language" ;
    ] .

# Shape for DynamicWing
twsh:DynamicWingShape a sh:NodeShape ;
    sh:targetClass tws:DynamicWing ;
    sh:property [
        sh:path ido:partOf ;
        sh:qualifiedValueShape [ sh:class tws:VesselSystem ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Dynamic wing must be part of a vessel" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:uniqueLang true ;
        sh:message "Dynamic wing label must be a string or language-tagged string, at most one per language" ;
    ] .

# Shape for FuelCellSystem (Ammonia Fuel Cell)
twsh:FuelCellSystemShape a sh:NodeShape ;
    sh:targetClass tws:FuelCellSystem ;
    sh:property [
        sh:path ido:partOf ;
        sh:qualifiedValueShape [ sh:class tws:VesselSystem ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Fuel cell must be part of a vessel" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:uniqueLang true ;
        sh:message "Fuel cell label must be a string or language-tagged string, at most one per language" ;
    ] ;
    sh:property [
        sh:path tws:consume ;
        sh:minCount 1 ;
        sh:class tws:Fuel ;
        sh:message "Fuel cell must consume at least one fuel" ;
    ] .
