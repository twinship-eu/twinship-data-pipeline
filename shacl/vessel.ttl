@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tws: <https://twin-ship.eu/twinship#> .
@prefix ido: <http://rds.posccaesar.org/ontology/lis14/rdl/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Shape for VesselSystem
tws:VesselSystemShape a sh:NodeShape ;
    sh:targetClass tws:VesselSystem ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Vessel should have at most one label" ;
    ] ;
    sh:property [
        sh:path tws:twDisplacementMaxInMT ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Displacement must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twVesselDraftAftMaxInM ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Aft draft must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twVesselDraftForMaxInM ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Forward draft must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twVesselDraftMidPortMaxInM ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Mid-ship port draft must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twVesselDraftMidStbdMaxInM ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Mid-ship starboard draft must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twVesselDepthOfWaterMaxInM ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Depth of water must be a number" ;
    ] ;
    # Structural: vessel must have at least one main engine
    sh:property [
        sh:path [ sh:inversePath ido:partOf ] ;
        sh:qualifiedValueShape [ sh:class tws:MainEngineSystem ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Vessel must have at least one main engine" ;
    ] ;
    # Structural: vessel must have at least one propeller (CPP or FPP)
    sh:property [
        sh:path [ sh:inversePath ido:partOf ] ;
        sh:qualifiedValueShape [
            sh:or (
                [ sh:class tws:CPP ]
                [ sh:class tws:FPP ]
            )
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Vessel must have at least one propeller (CPP or FPP)" ;
    ] .
