@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tws: <https://twin-ship.eu/twinship#> .
@prefix ido: <http://rds.posccaesar.org/ontology/lis14/rdl/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Shape for Emergency Equipment (Emergency Generator)
tws:EmergencyEquipmentShape a sh:NodeShape ;
    sh:targetClass tws:EmergencyEquipment ;
    sh:property [
        sh:path ido:partOf ;
        sh:minCount 1 ;
        sh:class tws:VesselSystem ;
        sh:message "Emergency equipment must be part of a vessel" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Emergency equipment should have at most one label" ;
    ] ;
    sh:property [
        sh:path tws:twEmergencyDieselGeneratorPowerMaxInKW ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Emergency generator power must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twEmergencyDieselGeneratorSpeedMaxInRevPerMin ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Emergency generator speed must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twEmergencyDieselGeneratorEmergencyDOMode ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:in (-1 0 1) ;
        sh:message "Emergency DO mode must be -1 (missing), 0 (off), or 1 (on)" ;
    ] .
