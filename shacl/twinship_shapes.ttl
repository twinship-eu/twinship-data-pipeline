@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix tws: <https://twin-ship.eu/twinship#> .
@prefix ido: <http://rds.posccaesar.org/ontology/lis14/rdl/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Shape for VesselSystem
tws:VesselSystemShape a sh:NodeShape ;
    sh:targetClass tws:VesselSystem ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Vessel should have at most one label" ;
    ] ;
    sh:property [
        sh:path tws:twDisplacementMaxInMT ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Displacement must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twPowerPropulsionTotalInKw ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Propulsion power must be a number" ;
    ] .

# Shape for MainEngineSystem
tws:MainEngineSystemShape a sh:NodeShape ;
    sh:targetClass tws:MainEngineSystem ;
    sh:property [
        sh:path ido:partOf ;
        sh:minCount 1 ;
        sh:class tws:VesselSystem ;
        sh:message "Main engine must be part of a vessel" ;
    ] ;
    sh:property [
        sh:path tws:twShaftPowerMaxInKW ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Shaft power must be a number" ;
    ] ;
    sh:property [
        sh:path tws:twShaftSpeedMaxInRevPerMin ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Shaft speed must be a number" ;
    ] .

# Shape for AuxiliaryEngineSystem
tws:AuxiliaryEngineSystemShape a sh:NodeShape ;
    sh:targetClass tws:AuxiliaryEngineSystem ;
    sh:property [
        sh:path ido:partOf ;
        sh:minCount 1 ;
        sh:class tws:VesselSystem ;
        sh:message "Auxiliary engine must be part of a vessel" ;
    ] ;
    sh:property [
        sh:path tws:twDieselEnginePowerMaxInKW ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:message "Engine power must be a number" ;
    ] .

# Shape for fuel consumption relationships
tws:FuelConsumerShape a sh:NodeShape ;
    sh:targetSubjectsOf tws:consume ;
    sh:property [
        sh:path tws:consume ;
        sh:minCount 1 ;
        sh:class tws:Fuel ;
        sh:message "consume property must reference a Fuel individual" ;
    ] .

# Shape for Fuel individuals
tws:FuelShape a sh:NodeShape ;
    sh:targetClass tws:Fuel ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Fuel must have exactly one label" ;
    ] ;
    sh:property [
        sh:path tws:twFuelDensityGrav15DegCKgPerLitre ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:double ;
        sh:minExclusive 0 ;
        sh:message "Fuel density must be a positive number" ;
    ] .
