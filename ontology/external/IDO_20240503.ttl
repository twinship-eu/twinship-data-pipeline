  rdfs:comment "Inspired by BFO's \"concretizes\". Note that the ISO 15926-14 definition diverges slightly from that in BFO, mainly in employing Feature where BFO has \"specifically dependent continuant\".",
    "TODO. Consider splitting this into two relations, one concretizesInFeature and another concretizesInActivity, to avoid a disjunctive domain.";
  rdfs:label "concretizes";
  rdfs:seeAlso obo:BFO_0000164, obo:RO_0000059 .

_:genid1 a owl:Class;
  owl:unionOf _:genid3 .

_:genid3 a rdf:List;
  rdf:first lis:Activity;
  rdf:rest _:genid2 .

_:genid2 a rdf:List;
  rdf:first lis:Feature;
  rdf:rest rdf:nil .

lis:connectedTo a owl:ObjectProperty, owl:SymmetricProperty;
  rdfs:domain lis:PhysicalObject;
  lis:equivalentEntityISO15926 lis2:ConnectionOfIndividual, lis12:connectedTo;
  rdfs:label "connectedTo" .

lis:containedBy a owl:ObjectProperty;
  rdfs:subPropertyOf lis:locatedRelativeTo;
  owl:inverseOf lis:contains;
  lis:equivalentEntityISO15926 lis2:ContainmentOfIndividual, lis12:containedBy;
  rdfs:label "containedBy" .

lis:contains a owl:ObjectProperty;
  rdfs:subPropertyOf lis:locatedRelativeTo;
  rdfs:domain lis:PhysicalObject;
  rdfs:range lis:PhysicalObject;
  lis:equivalentEntityISO15926 lis2:ContainmentOfIndividual, lis12:contains;
  rdfs:comment "For the DL profile, we restrict this relation to physical objects. Note that this rules out using \"lis:contains\" for spatial locations.";
  rdfs:label "contains" .

lis:createdBy a owl:ObjectProperty;
  owl:inverseOf lis:creates;
  lis:equivalentEntityISO15926 lis12:hasCauseOfBeginning;
  lis:relatedEntityISO15926 lis2:ClassOfCauseOfBeginningOfClassOfIndividual;
  rdfs:label "createdBy" .

lis:creates a owl:ObjectProperty;
  rdfs:domain lis:Activity;
  rdfs:range lis:PhysicalObject;
  lis:equivalentEntityISO15926 lis12:causesBeginningOf;
  lis:relatedEntityISO15926 lis2:ClassOfCauseOfBeginningOfClassOfIndividual;
  rdfs:comment "Use this relation to express that an activity brings a physical object into being. (Derived from class_of_cause_of_beginning_of_class_of_individual in Part 2).";
  rdfs:label "creates" .

lis:datumUOM a owl:ObjectProperty, owl:FunctionalProperty;
  rdfs:domain lis:QuantityDatum;
  rdfs:range lis:UnitOfMeasure;
  rdfs:comment "Relation (functional) to assign unit of measure to measurement data. There is no obvious analogue in ISO 15926-2 or ISO 15926-12.";
  rdfs:label "datumUOM" .

lis:directlyConnectedTo a owl:ObjectProperty, owl:SymmetricProperty;
  rdfs:subPropertyOf lis:connectedTo;
  lis:equivalentEntityISO15926 lis2:DirectConnection, lis12:directlyConnectedTo;
  rdfs:label "directlyConnectedTo" .

lis:dispositionOf a owl:ObjectProperty;
  owl:inverseOf lis:hasDisposition;
  rdfs:label "dispositionOf" .

lis:ends a owl:ObjectProperty;
  rdfs:subPropertyOf lis:activityBoundOf;
  owl:inverseOf lis:hasEnding;
  rdfs:label "ends" .

lis:featureOf a owl:ObjectProperty;
  rdfs:subPropertyOf lis:arrangedPartOf;
  owl:inverseOf lis:hasFeature;
  lis:equivalentEntityISO15926 lis2:FeatureWholePart, lis12:featureOf;
  rdfs:label "featureOf" .

lis:functionOf a owl:ObjectProperty;
  rdfs:subPropertyOf lis:dispositionOf;
  owl:inverseOf lis:hasFunction;
  rdfs:label "functionOf" .

lis:functionalPartOf a owl:ObjectProperty;
  rdfs:subPropertyOf lis:partOf;
  owl:inverseOf lis:hasFunctionalPart;
  rdfs:domain lis:FunctionalObject;
  rdfs:range lis:System;
  rdfs:comment "Used to capture the functional break-down of a system. Where x is a functional part of a system y, the realisation of one or more functions of x contributes to the performance of y.";
  rdfs:label "functionalPartOf" .

lis:hasActivityBound a owl:ObjectProperty;
  rdfs:subPropertyOf lis:hasActivityPart;
  lis:equivalentEntityISO15926 lis2:TemporalBounding, lis12:hasTemporalBound;
  rdfs:label "hasActivityBound" .

lis:hasActivityPart a owl:ObjectProperty;
  rdfs:subPropertyOf lis:hasPart;
  rdfs:domain lis:Activity;
  rdfs:range lis:Activity;
  lis:relatedEntityISO15926 lis2:TemporalWholePart, lis12:hasTemporalPart;
  rdfs:label "hasActivityPart" .

lis:hasArrangedPart a owl:ObjectProperty;
  rdfs:subPropertyOf lis:hasPart;
  rdfs:domain lis:PhysicalObject;
  lis:equivalentEntityISO15926 lis2:ArrangementOfIndividual, lis12:hasArrangedPart;
  rdfs:comment "In line with intended use, for the DL profile this relation has a domain restricted to physical objects.";
  rdfs:label "hasArrangedPart" .

lis:hasAssembledPart a owl:ObjectProperty;
  rdfs:subPropertyOf lis:hasArrangedPart;
  lis:equivalentEntityISO15926 lis2:AssemblyOfIndividual, lis12:hasAssembledPart;
  rdfs:comment "This is the recommended (super-) relation for capturing physical breakdown of mechanical assemblies.";
  rdfs:label "hasAssembledPart" .

lis:hasBeginning a owl:ObjectProperty;
  rdfs:subPropertyOf lis:hasActivityBound;
  lis:equivalentEntityISO15926 lis2:Beginning, lis12:hasBeginning;
  rdfs:label "hasBeginning" .

lis:hasDisposition a owl:ObjectProperty;
  rdfs:range lis:Disposition;
  rdfs:comment "Inspired by BFO's \"has disposition\" (RO_0000091).";
  rdfs:label "hasDisposition";
  rdfs:seeAlso obo:RO_0000091 .

lis:hasEnding a owl:ObjectProperty;
  rdfs:subPropertyOf lis:hasActivityBound;
  lis:equivalentEntityISO15926 lis2:Ending, lis12:hasEnd;
  rdfs:label "hasEnding" .

lis:hasFeature a owl:ObjectProperty;
  rdfs:subPropertyOf lis:hasArrangedPart;
  lis:equivalentEntityISO15926 lis2:FeatureWholePart, lis12:hasFeature;
  rdfs:comment "Example of usage: stating that an entity has a surface suitable for connection, such as a flange face.";
  rdfs:label "hasFeature" .

lis:hasFunction a owl:ObjectProperty;
  rdfs:subPropertyOf lis:hasDisposition;
  rdfs:range lis:Function;
  lis:relatedEntityISO15926 lis2:FunctionalPhysicalObject, lis12:FunctionalPhysicalObject;
  rdfs:comment "Inspired by BFO's \"has function\" (RO_0000085).";
  rdfs:label "hasFunction";
  rdfs:seeAlso obo:RO_0000085 .

lis:hasFunctionalPart a owl:ObjectProperty;
  rdfs:subPropertyOf lis:hasPart;
  rdfs:label "hasFunctionalPart" .

lis:hasInstalled a owl:ObjectProperty;
  owl:inverseOf lis:installedAs;
  rdfs:label "hasInstalled" .

lis:hasInterestIn a owl:ObjectProperty;
  owl:inverseOf lis:interestOf;
  lis:relatedEntityISO15926 lis2:LifecycleStage;
  rdfs:label "hasInterestIn" .

lis:hasPart a owl:ObjectProperty;
  owl:inverseOf lis:partOf;
  lis:equivalentEntityISO15926 lis12:hasPart, "CompositionOfIndividual";
  rdfs:label "hasPart" .

lis:hasParticipant a owl:ObjectProperty;
  owl:inverseOf lis:participantIn;
  rdfs:domain lis:Activity;
  lis:equivalentEntityISO15926 lis2:Participation, lis12:hasParticipant;
  rdfs:comment "Note that BFO does not have 'has participant' as a subrelation of 'has part'. This can be motivated in that 4D objects, here members of Activity, are at least not obviously able to have 3D parts.",
    "This is the recommended superrelation for types of participation by entities in activities -- the agent, the matter being acted upon, etc.";
  rdfs:label "hasParticipant" .

lis:hasPhysicalQuantity a owl:ObjectProperty;
  rdfs:subPropertyOf lis:hasQuality;
  owl:inverseOf lis:physicalQuantityOf;
  rdfs:domain lis:PhysicalObject;
  rdfs:range lis:PhysicalQuantity;
  rdfs:label "hasPhysicalQuantity" .

lis:hasQuality a owl:ObjectProperty;
  owl:inverseOf lis:qualityOf;
  rdfs:range lis:Quality;
  rdfs:label "hasQuality" .

lis:hasResident a owl:ObjectProperty;
  rdfs:subPropertyOf lis:locatedRelativeTo;
  owl:inverseOf lis:residesIn;
  lis:relatedEntityISO15926 lis2:RelativeLocation, lis12:locatedRelativeTo;
  rdfs:label "hasResident" .

lis:hasRole a owl:ObjectProperty;
  owl:inverseOf lis:roleOf;
  rdfs:range lis:Role;
  lis:relatedEntityISO15926 lis2:Role;
  rdfs:comment "Inspired by BFO's \"has role\" (RO_0000087)";
  rdfs:label "hasRole";
  rdfs:seeAlso obo:RO_0000087 .

lis:hasSubLocation a owl:ObjectProperty;
  rdfs:subPropertyOf lis:hasPart;
  owl:inverseOf lis:subLocationOf;
  rdfs:domain lis:Location;
  rdfs:range lis:Location;
  rdfs:label "hasSubLocation" .

lis:installedAs a owl:ObjectProperty;
  rdfs:domain lis:PhysicalObject;
  rdfs:range lis:FunctionalObject;
  rdfs:label "installedAs" .

lis:interestOf a owl:ObjectProperty;
  lis:relatedEntityISO15926 lis2:LifecycleStage;
  rdfs:comment "Derived from \"LifecycleStage\" of Part 2, this is a superproperty suitable for various intentional relationships, such as planning, approving, or ordering. The Part 2 name \"lifecycle stage\" is likely to confuse, but the intended use of this type is clear enough from this Part 2 annotation to ClassOfLifecycleStage: \"EXAMPLE Planned, required, expected, and proposed can be represented by instances of [class_of_lifecycle_stage].\"";
  rdfs:label "interestOf" .

lis:isAbout a owl:ObjectProperty;
  owl:inverseOf lis:representedIn;
  rdfs:label "isAbout";
  rdfs:seeAlso obo:IAO_0000136 .

lis:locatedRelativeTo a owl:ObjectProperty, owl:SymmetricProperty;
  lis:equivalentEntityISO15926 lis2:RelativeLocation, lis12:locatedRelativeTo;
  rdfs:label "locatedRelativeTo" .

lis:occursRelativeTo a owl:ObjectProperty, owl:SymmetricProperty;
  rdfs:domain lis:Activity;
  rdfs:range lis:Activity;
  lis:remodelsEntityISO15926 lis2:TemporalSequence;
  rdfs:comment "This relation is introduced for the DL profile as a top relation for various temporal relations between activities (only).";
  rdfs:label "occursRelativeTo" .

lis:partOf a owl:ObjectProperty;
  lis:equivalentEntityISO15926 lis2:CompositionOfIndividual, lis12:partOf;
  rdfs:label "partOf" .

lis:participantIn a owl:ObjectProperty;
  lis:equivalentEntityISO15926 lis2:Participation, lis12:participantIn;
  rdfs:label "participantIn" .

lis:physicalQuantityOf a owl:ObjectProperty;
  rdfs:subPropertyOf lis:qualityOf;
  rdfs:label "physicalQuantityOf" .

lis:qualityOf a owl:ObjectProperty;
  rdfs:label "qualityOf" .

lis:qualityQuantifiedAs a owl:ObjectProperty;
  rdfs:subPropertyOf lis:representedIn;
  owl:inverseOf lis:quantifiesQuality;
  rdfs:domain lis:Quality;
  rdfs:range lis:QuantityDatum;
  lis:relatedEntityISO15926 lis2:PropertyQuantification, lis12:PhysicalProperty, lis12:QuantityMeasure;
  rdfs:comment "This relation is inspired by the relation \"is quality measured as\" of the Information Artefact Ontology. The term \"quantified\" replaces \"measured\" to support cases where measurement is not involved, as in e.g. estimates.";
  rdfs:label "qualityQuantifiedAs" .

lis:quantifiesQuality a owl:ObjectProperty;
  rdfs:subPropertyOf lis:isAbout;
  lis:relatedEntityISO15926 lis2:RepresentationOfThing, lis12:representationByInformationObject;
  rdfs:label "quantifiesQuality" .

lis:realizedIn a owl:ObjectProperty;
  owl:inverseOf lis:realizes;
  rdfs:domain lis:RealizableEntity;
  rdfs:range lis:Activity;
  rdfs:comment "Inspired by BFO's \"realized in\" (BFO_0000054)";
  rdfs:label "realizedIn";
  rdfs:seeAlso obo:BFO_0000054 .

lis:realizes a owl:ObjectProperty;
  rdfs:label "realizes";
  rdfs:seeAlso obo:BFO_0000055 .

lis:representedBy a owl:ObjectProperty;
  rdfs:subPropertyOf lis:representedIn;
  owl:inverseOf lis:represents;
  rdfs:range lis:InformationObject;
  lis:equivalentEntityISO15926 lis2:RepresentationOfThing, lis12:representationByInformationObject;
  rdfs:comment "In Part 2, this is the top level relation from things to information objects. For this Part, we introduce representedIn, as the more generic inverse of isAbout.";
  rdfs:label "representedBy" .

lis:representedIn a owl:ObjectProperty;
  rdfs:range lis:InformationObject;
  lis:relatedEntityISO15926 lis2:RepresentationOfThing, lis12:representationByInformationObject;
  rdfs:comment "Also see \"is about\" IAO_0000136 of the Information Artifact Ontology, which may be better named for a maximally general relation of \"aboutness\" (but note that \"is about\" goes in the opposite direction of \"representedIn\").";
  rdfs:label "representedIn";
  rdfs:seeAlso obo:IAO_0000136 .

lis:represents a owl:ObjectProperty;
  rdfs:subPropertyOf lis:isAbout;
  lis:equivalentEntityISO15926 lis2:RepresentationOfThing;
  lis:relatedEntityISO15926 lis12:representationByInformationObject;
  rdfs:label "represents" .

lis:residesIn a owl:ObjectProperty;
  rdfs:subPropertyOf lis:locatedRelativeTo;
  rdfs:domain lis:PhysicalObject;
  rdfs:range lis:Location;
  lis:relatedEntityISO15926 lis2:RelativeLocation, lis12:locatedRelativeTo;
  rdfs:comment "x residesIn y if x is a physical object that is located in the location y.";
  rdfs:label "residesIn" .

lis:roleOf a owl:ObjectProperty;
  lis:relatedEntityISO15926 lis2:Role;
  rdfs:comment "Inspired by BFO's \"role of\" (RO_0000081)";
  rdfs:label "roleOf";
  rdfs:seeAlso obo:RO_0000081 .

lis:subLocationOf a owl:ObjectProperty;
  rdfs:subPropertyOf lis:partOf;
  rdfs:label "subLocationOf" .

lis:approvedOn a owl:DatatypeProperty;
  lis:relatedEntityISO15926 lis2:Approval;
  rdfs:comment "This is a super-property for stating the time that an entity was approved, derived from Part 2 \"approval\". Introduce sub-properties to match different contexts and types of approval. The range of sub-properties should be xsd:date or xsd:dateTime.";
  rdfs:label "approvedOn" .

lis:datumValue a owl:DatatypeProperty;
  rdfs:comment "This relation is inspired by the relation \"has measurement value\" of the Information Artefact Ontology.";
  rdfs:label "datumValue" .

lis:qualityQuantityValue a owl:DatatypeProperty;
  rdfs:comment "This is a super-property for \"shortcut\" relations that combine a quality, the weak lis:qualityQuantifiedAs, and a unit of measure into a simple data property. For instance, \"mass in kilograms\" can be introduced as such a data property, for expressing the mass of an entity on the kilogram scale. lis:qualityQuantifiedAs is weak in the sense that it doesn't distinguish between designed or estimated, and measured, values.";
  rdfs:label "qualityQuantityValue" .

lis:Activity a owl:Class;
  lis:equivalentEntityISO15926 lis2:Activity, lis12:Activity;
  rdfs:label "Activity" .

lis:Aspect a owl:Class;
  rdfs:comment "The class Aspect is closely related to \"specifically dependent continuant\" in BFO (BFO_0000020).",
    "There is no direct analogue to Aspect in ISO 15926-2 or ISO 15926-12.";
  rdfs:label "Aspect";
  rdfs:seeAlso obo:BFO_0000020 .

lis:Compound a owl:Class;
  rdfs:subClassOf lis:PhysicalObject;
  lis:equivalentEntityISO15926 lis12:Compound;
  lis:relatedEntityISO15926 lis2:ClassOfCompound;
  rdfs:label "Compound" .

lis:Disposition a owl:Class;
  rdfs:subClassOf lis:RealizableEntity;
  rdfs:comment "Inspired by the BFO class \"disposition\" (BFO_0000016).";
  rdfs:label "Disposition";
  rdfs:seeAlso obo:BFO_0000016 .

lis:Event a owl:Class;
  rdfs:subClassOf lis:Activity;
  lis:equivalentEntityISO15926 lis2:Event, lis12:Event;
  rdfs:label "Event" .

lis:Feature a owl:Class;
  rdfs:subClassOf lis:PhysicalObject;
  lis:equivalentEntityISO15926 lis12:Feature;
  lis:relatedEntityISO15926 lis2:ClassOfFeature;
  rdfs:label "Feature" .

lis:Function a owl:Class;
  rdfs:subClassOf lis:Disposition;
  lis:relatedEntityISO15926 lis2:FunctionalPhysicalObject, lis12:FunctionalPhysicalObject;
  rdfs:comment "Inspired by the BFO class \"function\" (BFO_0000034).";
  rdfs:label "Function";
  rdfs:seeAlso obo:BFO_0000034 .

lis:FunctionalObject a owl:Class;
  rdfs:subClassOf lis:Object, _:genid4, _:genid5;
  lis:relatedEntityISO15926 lis2:FunctionalPhysicalObject, lis12:ClassOfPhysicalObjectByFunction,
    lis12:FunctionalPhysicalObject;
  rdfs:comment "A functional object is part of a system, and has a function whose realisation contributes to the performance of the system as a whole.";
  rdfs:label "FunctionalObject";
  skos:example "An item on a Process Flow Diagram (PFD) or Process and Instrumentation Diagram (P&ID) should be classified as a FunctionalObject.";
  skos:note "A class of artefacts such as Pump is not a subclass of FunctionalObject: a pump that is not in service is not part of a system. However, an individual functional location should in general be given some high-level artefact classification in addition to its description as part of a system." .

_:genid4 a owl:Restriction;
  owl:someValuesFrom lis:System;
  owl:onProperty lis:functionalPartOf .

_:genid5 a owl:Restriction;
  owl:someValuesFrom lis:Function;
  owl:onProperty lis:hasFunction .

lis:InanimatePhysicalObject a owl:Class;
  rdfs:subClassOf lis:PhysicalObject;
  lis:equivalentEntityISO15926 lis12:InanimatePhysicalObject;
  lis:relatedEntityISO15926 lis2:ClassOfInanimatePhysicalObject;
  rdfs:label "InanimatePhysicalObject" .

lis:InformationObject a owl:Class;
  rdfs:subClassOf lis:Object;
  lis:relatedEntityISO15926 lis2:ClassOfInformationObject, lis12:InformationContent,
    lis12:InformationObject;
  rdfs:label "InformationObject" .

lis:Location a owl:Class;
  rdfs:subClassOf lis:Object;
  lis:equivalentEntityISO15926 lis2:SpatialLocation, lis12:RegionInSpace;
  rdfs:label "Location" .

lis:Object a owl:Class;
  lis:relatedEntityISO15926 lis2:PossibleIndividual, lis12:Individual;
  rdfs:label "Object" .

lis:Organism a owl:Class;
  rdfs:subClassOf lis:PhysicalObject;
  lis:equivalentEntityISO15926 lis12:Organism;
  lis:relatedEntityISO15926 lis2:ClassOfOrganism;
  rdfs:label "Organism" .

lis:Organization a owl:Class;
  rdfs:subClassOf lis:Object;
  lis:equivalentEntityISO15926 lis12:Organization;
  lis:relatedEntityISO15926 lis2:ClassOfOrganization;
  rdfs:label "Organization" .

lis:PeriodInTime a owl:Class;
  rdfs:subClassOf lis:Activity;
  lis:equivalentEntityISO15926 lis2:PeriodInTime, lis12:PeriodInTime;
  rdfs:label "PeriodInTime" .

lis:Person a owl:Class;
  rdfs:subClassOf lis:Organism;
  lis:equivalentEntityISO15926 lis12:Person;
  lis:relatedEntityISO15926 lis2:ClassOfPerson;
  rdfs:label "Person" .

lis:Phase a owl:Class;
  rdfs:subClassOf lis:InanimatePhysicalObject;
  lis:relatedEntityISO15926 lis2:Phase, lis12:Phase;
  rdfs:label "Phase" .

lis:PhysicalObject a owl:Class;
  rdfs:subClassOf lis:Object;
  lis:deprecatedEntityISO15926 lis2:MaterializedPhysicalObject, lis12:MaterializedPhysicalObject;
  lis:equivalentEntityISO15926 lis2:PhysicalObject, lis12:PhysicalObject;
  rdfs:label "PhysicalObject" .

lis:PhysicalQuantity a owl:Class;
  rdfs:subClassOf lis:Quality;
  lis:equivalentEntityISO15926 lis12:PhysicalQuantity;
  lis:relatedEntityISO15926 lis2:Property;
  rdfs:label "PhysicalQuantity" .

lis:PointInSpace a owl:Class;
  rdfs:subClassOf lis:SpatialLocation;
  lis:equivalentEntityISO15926 lis12:PointInSpace;
  rdfs:label "PointInSpace" .

lis:PointInTime a owl:Class;
  rdfs:subClassOf lis:Event;
  lis:equivalentEntityISO15926 lis2:PointInTime, lis12:PointInTime;
  rdfs:label "PointInTime" .

lis:Quality a owl:Class;
  rdfs:subClassOf lis:Aspect;
  lis:relatedEntityISO15926 lis2:Property, lis12:Quantity;
  rdfs:comment "The class Quality and its subclass PhysicalQuantity inspired by corresponding classes included in the DOLCE and BFO (BFO_0000019) upper ontologies.";
  rdfs:label "Quality";
  rdfs:seeAlso obo:BFO_0000019 .

lis:QuantityDatum a owl:Class;
  rdfs:subClassOf lis:InformationObject;
  lis:relatedEntityISO15926 lis12:Quantity;
  rdfs:comment "This class is inspired by the class \"measurement datum\" of the Information Artefact Ontology. The change of wording from \"measurement\" to \"quantity\" is intended to support cases where measurement is not involved, such as with nominal values.";
  rdfs:label "QuantityDatum";
  rdfs:seeAlso obo:IAO_0000109 .

lis:RealizableEntity a owl:Class;
  rdfs:subClassOf lis:Aspect;
  rdfs:comment "Inspired by the BFO class \"realizable entity\" (BFO_0000017).";
  rdfs:label "RealizableEntity";
  rdfs:seeAlso obo:BFO_0000017 .

lis:RegionInSpace a owl:Class;
  rdfs:subClassOf lis:SpatialLocation;
  lis:equivalentEntityISO15926 lis12:RegionInSpace;
  rdfs:label "RegionInSpace" .

lis:Role a owl:Class;
  rdfs:subClassOf lis:RealizableEntity;
  lis:relatedEntityISO15926 lis2:Role, lis2:RoleAndDomain;
  rdfs:comment "This class is motivated in the Part 2 'role' entity type, and in the same-named BFO class (BFO_0000023). The specific meaning of roles in ISO 15926-2 should be investigated, even though the examples given there are clear enough.";
  rdfs:label "Role";
  rdfs:seeAlso obo:BFO_0000023 .

lis:ScalarQuantityDatum a owl:Class;
  rdfs:subClassOf lis:QuantityDatum, _:genid6, _:genid7;
  lis:relatedEntityISO15926 lis12:PhysicalQuantity;
  rdfs:comment "A scalar quantity datum has a unique unit of measure and a unique numeric value. This class is inspired by the class \"scalar measurement datum\" of the Information Artefact Ontology.";
  rdfs:label "ScalarQuantityDatum";
  rdfs:seeAlso obo:IAO_0000032 .

_:genid6 a owl:Restriction;
  owl:someValuesFrom lis:UnitOfMeasure;
  owl:onProperty lis:datumUOM .

_:genid7 a owl:Restriction;
  owl:someValuesFrom rdfs:Literal;
  owl:onProperty lis:datumValue .

lis:Scale a owl:Class;
  rdfs:subClassOf lis:UnitOfMeasure;
  lis:equivalentEntityISO15926 lis2:Scale, lis12:Scale;
  rdfs:label "Scale" .

lis:Site a owl:Class;
  rdfs:subClassOf lis:Location;
  lis:relatedEntityISO15926 lis2:RegionInSpace, lis2:SpatialLocation;
  rdfs:comment "From BFO: \"b is a site means: b is a three-dimensional immaterial entity that is (partially or wholly) bounded by a material entity or it is a three-dimensional immaterial part thereof. (axiom label in BFO2 Reference: [034-002])\"",
    "This class is inspired by the BFO/Information Artefact Ontology class \"site\" (BFO_0000029).";
  rdfs:label "Site";
  rdfs:seeAlso obo:BFO_0000029 .

lis:SpatialLocation a owl:Class;
  rdfs:subClassOf lis:Location;
  lis:relatedEntityISO15926 lis2:RegionInSpace, lis2:SpatialLocation;
  rdfs:label "SpatialLocation" .

lis:Stream a owl:Class;
  rdfs:subClassOf lis:InanimatePhysicalObject;
  lis:equivalentEntityISO15926 lis2:Stream, lis12:Stream;
  rdfs:label "Stream" .

lis:System a owl:Class;
  rdfs:subClassOf lis:FunctionalObject, _:genid8;
  lis:relatedEntityISO15926 lis2:FunctionalPhysicalObject, lis12:FunctionalPhysicalObject;
  rdfs:comment "A system is a complex of functional parts working together. Each part contributes to the realisation of the system's function (though not necessarily every part in every performance of the system).";
  rdfs:label "System";
  skos:note "A functional location that does not itself have functional parts is not a system." .

_:genid8 a owl:Restriction;
  owl:someValuesFrom lis:FunctionalObject;
  owl:onProperty lis:hasFunctionalPart .

lis:UnitOfMeasure a owl:Class;
  rdfs:subClassOf lis:InformationObject;
  lis:relatedEntityISO15926 lis12:QuantityMeasure;
  rdfs:label "UnitOfMeasure" .

_:genid9 a owl:AllDisjointClasses;
  owl:members _:genid12 .

_:genid12 a rdf:List;
  rdf:first lis:Activity;
  rdf:rest _:genid11 .

_:genid11 a rdf:List;
  rdf:first lis:Aspect;
  rdf:rest _:genid10 .

_:genid10 a rdf:List;
  rdf:first lis:Object;
  rdf:rest rdf:nil .

_:genid13 a owl:AllDisjointClasses;
  owl:members _:genid17 .

_:genid17 a rdf:List;
  rdf:first lis:InformationObject;
  rdf:rest _:genid16 .

_:genid16 a rdf:List;
  rdf:first lis:Location;
  rdf:rest _:genid15 .

_:genid15 a rdf:List;
  rdf:first lis:Organization;
  rdf:rest _:genid14 .

_:genid14 a rdf:List;
  rdf:first lis:PhysicalObject;
  rdf:rest rdf:nil .
