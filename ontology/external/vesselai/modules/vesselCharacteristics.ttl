	:hasBuiltDate rdfs:range xsd:string .

### Cargo
	:Cargo rdfs:subClassOf dul:Object ; rdfs:comment "The type of cargo loaded on a vessel. " .
	:DangerousGoods rdfs:subClassOf :Cargo ; rdfs:comment "Dangerous goods are subject to transport, workplace, storage, consumer and environment protection regulations, to prevent accidents to persons, property or the environment, to other goods or to the means of transport employed. " .

	:Explosive_Goods rdfs:subClassOf :DangerousGoods ; rdfs:comment "UN Class 1 dangerous goods." .
	:GasesGoods rdfs:subClassOf :DangerousGoods ; rdfs:comment "UN Class 2 dangerous goods." .
	:FlammableGas rdfs:subClassOf :GasesGoods .
	:ToxicGas rdfs:subClassOf :GasesGoods .
	:NonFlammableNonToxicGas rdfs:subClassOf :GasesGoods .
	:NonFlammableNonToxicGas owl:disjointWith :FlammableGas .
	:NonFlammableNonToxicGas owl:disjointWith :ToxicGas .
	:FlammableLiquidGoods rdfs:subClassOf :DangerousGoods ; rdfs:comment "UN Class 3 dangerous goods." .
	:DangerousSolidsGoods rdfs:subClassOf :DangerousGoods ; rdfs:comment "UN Class 4 dangerous goods." .
	:FlammableSolid rdfs:subClassOf :DangerousSolidsGoods .
	:CombustibleSubstance rdfs:subClassOf :DangerousSolidsGoods ; rdfs:comment "Spontaneously combustible substance" .
	:SolidFlammableOnWater rdfs:subClassOf :DangerousSolidsGoods ; rdfs:comment "Substance which emits flammable gas in contact with water" .
	:OxidizersOrOrganicPeroxides rdfs:subClassOf :DangerousGoods ; rdfs:comment "UN Class 5 dangerous goods." .
	:OxidisingSubstance rdfs:subClassOf :OxidizersOrOrganicPeroxides .
	:OrganicPeroxide rdfs:subClassOf :OxidizersOrOrganicPeroxides .
	:ToxicOrInfectiousSubstances rdfs:subClassOf :DangerousGoods ; rdfs:comment "UN Class 6 dangerous goods." .
	:ToxicSubstance rdfs:subClassOf :ToxicOrInfectiousSubstances .
	:InfectiousSubstance rdfs:subClassOf :ToxicOrInfectiousSubstances .
	:RadioactiveMaterialGoods rdfs:subClassOf :DangerousGoods ; rdfs:comment "UN Class 7 dangerous goods." .
	:CorrosiveSubstancesGoods rdfs:subClassOf :DangerousGoods ; rdfs:comment "UN Class 8 dangerous goods." .
	:MiscellaneousDangerousSubstances rdfs:subClassOf :DangerousGoods ; rdfs:comment "UN Class 9 dangerous goods." .


