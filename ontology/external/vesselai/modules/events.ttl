rdf:Ontology owl:imports <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
rdf:Ontology owl:imports <http://www.opengis.net/ont/geosparql#> .

@prefix : <http://www.vesselAI-project.eu/ontology#> .
@prefix ogc: <http://www.opengis.net/ont/geosparql#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .

:occursAt rdfs:domain :Event ; rdfs:range :TrajectoryPart .

:triggers rdfs:domain :TrajectoryPart ; rdfs:range :Event .

:hasReferencePosition rdfs:domain :Event ; rdfs:range ogc:Geometry .

:hasReferenceTime rdfs:domain :Event ; rdfs:range time:TemporalEntity .

:triggers rdfs:domain :Event ; rdfs:range :Event .
## we can use :affects to relate :Event with :Entity (or any subclass such as :TrajectoryPart)


:Mean_sea_level_pressure_surface rdfs:domain :WeatherCondition ; rdfs:range xsd:string . 
:10_metre_U_wind_component_surface rdfs:domain :WeatherCondition ; rdfs:range xsd:string . 
:10_metre_V_wind_component_surface rdfs:domain :WeatherCondition ; rdfs:range xsd:string . 
:2_metre_temperature_surface rdfs:domain :WeatherCondition ; rdfs:range xsd:string . 
:2_metre_dewpoint_temperature_surface rdfs:domain :WeatherCondition ; rdfs:range xsd:string . 
:Total_precipitation_surface_1_Hour_Accumulation rdfs:domain :WeatherCondition ; rdfs:range xsd:string . 
:Sea_surface_temperature_surface rdfs:domain :WeatherCondition ; rdfs:range xsd:string . 
:Mean_wave_direction_msl rdfs:domain :WeatherCondition ; rdfs:range xsd:string . 
:Mean_wave_period_msl rdfs:domain :WeatherCondition ; rdfs:range xsd:string . 
:hasTimeStart rdfs:domain time:TemporalEntity ; rdfs:range xsd:string .
:hasTimeEnd rdfs:domain time:TemporalEntity ; rdfs:range xsd:string .
:TimeInterval rdfs:subClassOf time:TemporalEntity .

:Event rdfs:subClassOf dul:Event ; rdfs:comment "A sub-class of Events that refer or affect moving objects in the maritime domain" .
:Environmental rdfs:subClassOf :Event ; rdfs:comment "Environmental events affecting moving objects' behaviour" .
:WeatherCondition rdfs:subClassOf :Environmental .
:WeatherCondition rdfs:subClassOf :Dynamic ; rdfs:comment "A weather condition reported for an associated Region" .
:LowLevel rdfs:subClassOf :Event ; rdfs:comment "A sub-class of event that can be identified only by the sensor' recordings" .
:MaritimeLowLevelEvent rdfs:subClassOf :LowLevel .

## WMO codes registry

:hasWeatherPhenomena rdfs:domain :WeatherCondition ; rdfs:range :WeatherPhenomena ; rdfs:label "Significant weather phenomena" ; rdfs:seeAlso <http://www.wmo.int/pages/prog/www/WMOCodes/WMO306_vI1/VolumeI.1.html> ; rdfs:comment "This register provides terms that may be used to describe significant [recent], present and forecast weather - enumerating the set of meteorologically valid options defined in WMO No. 306 Vol 1 code-table 4678. Each term comprises one or more of the elements from code-table 4678: 'intensity or proximity', 'descriptor', 'precipitation', 'obscuration' and 'other'."@en ; owl:versionInfo 3 .

