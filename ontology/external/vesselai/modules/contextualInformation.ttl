:GreySealProtectionArea rdfs:subClassOf :ProtectedArea .
:LimitedManagementZoneOfNationalPark rdfs:subClassOf :ProtectedArea .
:LimitedManagementZoneOfNatureReserve rdfs:subClassOf :ProtectedArea .
:LimitedManagementZoneOfProtectedLandscape rdfs:subClassOf :ProtectedArea .
:ManagedConservationZoneOfNationalPark rdfs:subClassOf :ProtectedArea .
:ManagedConservationZoneOfNatureReserve rdfs:subClassOf :ProtectedArea .
:ManagedConservationZoneOfProtectedLandscape rdfs:subClassOf :ProtectedArea .
:NatureMonument rdfs:subClassOf :ProtectedArea .
:NoBerthingZone_noEntryZoneExceptForFisheries rdfs:subClassOf :ProtectedArea .
:ProtectedNatureMonument rdfs:subClassOf :ProtectedArea .
:RegionalNatureMonument rdfs:subClassOf :ProtectedArea .
:RegionalZakaznik rdfs:subClassOf :ProtectedArea .
:RestrictedArea rdfs:subClassOf :ProtectedArea .
:SiteOfScientificImportance rdfs:subClassOf :ProtectedArea .
:StateZakaznik rdfs:subClassOf :ProtectedArea .
:StrictNatureReserveOfNationalPark rdfs:subClassOf :ProtectedArea .
:UnzonedProtectedArea rdfs:subClassOf :ProtectedArea .
:WildernessConservationZoneOfNationalPark rdfs:subClassOf :ProtectedArea .
:WildernessConservationZoneOfNatureReserve rdfs:subClassOf :ProtectedArea .
:WildernessConservationZoneOfProtectedLandscape rdfs:subClassOf :ProtectedArea .
:WildlifePreserve rdfs:subClassOf :ProtectedArea .
:BirdSanctuary rdfs:subClassOf :ProtectedArea .
:CertifiedNatureReserve_flemishRegion_ rdfs:subClassOf :ProtectedArea .
:Co-managementArea rdfs:subClassOf :ProtectedArea .
:InternationalSignificanceNaturalMarineArea rdfs:subClassOf :ProtectedArea .
:LocallyManagedProtectedArea rdfs:subClassOf :ProtectedArea .
:NacionalPark rdfs:subClassOf :ProtectedArea .
:NatureMonument_categoryIiiIucn_ rdfs:subClassOf :ProtectedArea .
:NatureReserve_filfla_ rdfs:subClassOf :ProtectedArea .
:NatureReserve_integral_ rdfs:subClassOf :ProtectedArea .
:NatureReserve_islands_ rdfs:subClassOf :ProtectedArea .
:OtherProtectedNaturalRegionalAreas rdfs:subClassOf :ProtectedArea .
:Others rdfs:subClassOf :ProtectedArea .

