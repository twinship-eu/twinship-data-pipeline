        <rdfs:subClassOf rdf:resource="http://www.vesselAI-project.eu/ontology#Cargo_Vessel"/>
    </owl:Class>
    


    <!-- http://www.vesselAI-project.eu/ontology#Bunker -->

    <owl:Class rdf:about="http://www.vesselAI-project.eu/ontology#Bunker">
        <rdfs:subClassOf rdf:resource="http://www.vesselAI-project.eu/ontology#Vessel"/>
        <rdfs:comment>A bunker is generally applied to the storage of petroleum products in tanks, and the practice and business of refueling ships. Bunkering operations are located at seaports, and they include the storage of bunker (ship) fuels and the provision of the fuel to vessels. Bunkering includes the shipboard logistics of loading fuel and distributing it among available bunkers (on-board fuel tanks).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.vesselAI-project.eu/ontology#Bunkering_Tanker -->

    <owl:Class rdf:about="http://www.vesselAI-project.eu/ontology#Bunkering_Tanker">
