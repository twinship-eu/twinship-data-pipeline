        <rdfs:subClassOf rdf:resource="http://www.vesselAI-project.eu/ontology#Place"/>
        <rdfs:comment>A line following the general contour of the shore, except that in cases of inlets or bays less than 30 nautical miles in width, the line shall pass directly across the inlet or bay to intersect the general contour on the opposite side.</rdfs:comment>
    </owl:Class>
    


