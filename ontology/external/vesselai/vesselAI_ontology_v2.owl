    <!-- http://www.vesselAI-project.eu/ontology#hasWeatherPhenomena -->

    <owl:ObjectProperty rdf:about="http://www.vesselAI-project.eu/ontology#hasWeatherPhenomena">
        <rdfs:domain rdf:resource="http://www.vesselAI-project.eu/ontology#WeatherCondition"/>
        <rdfs:range rdf:resource="http://www.vesselAI-project.eu/ontology#WeatherPhenomena"/>
        <rdfs:comment xml:lang="en">This register provides terms that may be used to describe significant [recent], present and forecast weather - enumerating the set of meteorologically valid options defined in WMO No. 306 Vol 1 code-table 4678. Each term comprises one or more of the elements from code-table 4678: &apos;intensity or proximity&apos;, &apos;descriptor&apos;, &apos;precipitation&apos;, &apos;obscuration&apos; and &apos;other&apos;.</rdfs:comment>
        <rdfs:label>Significant weather phenomena</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.wmo.int/pages/prog/www/WMOCodes/WMO306_vI1/VolumeI.1.html"/>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</owl:versionInfo>
    </owl:ObjectProperty>
    


