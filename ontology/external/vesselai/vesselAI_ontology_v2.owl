    </owl:Class>
    


    <!-- http://www.vesselAI-project.eu/ontology#DangerousGoods -->

    <owl:Class rdf:about="http://www.vesselAI-project.eu/ontology#DangerousGoods">
        <rdfs:subClassOf rdf:resource="http://www.vesselAI-project.eu/ontology#Cargo"/>
        <rdfs:comment>Dangerous goods are subject to transport, workplace, storage, consumer and environment protection regulations, to prevent accidents to persons, property or the environment, to other goods or to the means of transport employed. </rdfs:comment>
    </owl:Class>
    


    <!-- http://www.vesselAI-project.eu/ontology#DangerousGoodsTransport -->

    <owl:Class rdf:about="http://www.vesselAI-project.eu/ontology#DangerousGoodsTransport">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.vesselAI-project.eu/ontology#hasPart"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.vesselAI-project.eu/ontology#transports"/>
                        <owl:someValuesFrom rdf:resource="http://www.vesselAI-project.eu/ontology#DangerousGoods"/>
                    </owl:Restriction>
                </owl:onClass>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.vesselAI-project.eu/ontology#DangerousTrajectory"/>
        <rdfs:comment>A dangerous trajectory that has at least one trajectory part associated with dangerous goods</rdfs:comment>
    </owl:Class>
    


