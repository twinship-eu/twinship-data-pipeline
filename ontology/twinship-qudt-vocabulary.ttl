quantitykind:Energy a :TwinShipQuantityKindForEnergy .
unit:KiloW-HR a :TwinShipUnitForEnergy .
unit:MegaW-HR a :TwinShipUnitForEnergy .
unit:GigaW-HR a :TwinShipUnitForEnergy .


