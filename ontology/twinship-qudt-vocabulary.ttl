@prefix : <https://twin-ship.eu/twinship#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

# #################################################################
# #
# #    Ontology
# #
# #################################################################

<https://twin-ship.eu/twinship/qudt-vocabulary> a owl:Ontology ;
    rdfs:label "TwinShip QUDT Quantity Vocabulary" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rightsHolder "TwinShip Consortium" ;
    rdfs:comment """QUDT quantity and unit family classes for the TwinShip ontology.

Modeling approach (Nexus advanced pattern):
  For each quantity kind used in TwinShip, this file defines:
    - TwinShipQuantityKindFor[X]  — subClassOf qudt:QuantityKind
    - TwinShipUnitFor[X]          — subClassOf qudt:Unit
    - TwinShipQuantityValue[X]    — subClassOf qudt:QuantityValue
    - TwinShipQuantity[X]         — subClassOf qudt:Quantity (with kind/value restrictions)
    - hasQuantity[X]              — owl:ObjectProperty, subPropertyOf qudt:hasQuantity
  QUDT unit and quantitykind individuals are typed as members of the family classes.

  This file is imported by twinship-base.ttl and therefore available to all domain
  modules automatically. Domain modules (vessel.ttl, operational-context.ttl,
  weather-conditions.ttl) add owl:someValuesFrom restrictions on the hasQuantity[X]
  properties directly to their domain classes.

Coexistence with XSD data properties:
  The tw-prefixed owl:DatatypeProperty declarations (rdfs:range xsd:double / xsd:decimal)
  in the domain modules are retained unchanged. They provide efficient SPARQL query access
  to literal values. The QUDT object properties here provide semantic grounding, unit
  disambiguation, and standards alignment.""" ;
    owl:imports <http://qudt.org/schema/qudt/>,
        <http://qudt.org/vocab/quantitykind/>,
        <http://qudt.org/vocab/unit/> ;
    owl:versionIRI <https://twin-ship.eu/twinship/qudt-vocabulary/0.1.2> .


# #################################################################
# #
# #    1. POWER (kW)
# #
# #################################################################

:TwinShipQuantityKindForPower a owl:Class ;
    rdfs:label "TwinShip Quantity Kind For Power" ;
    rdfs:subClassOf qudt:QuantityKind .

:TwinShipUnitForPower a owl:Class ;
    rdfs:label "TwinShip Unit For Power" ;
    rdfs:subClassOf qudt:Unit .

:TwinShipQuantityValuePower a owl:Class ;
    rdfs:label "TwinShip Quantity Value Power" ;
    rdfs:subClassOf qudt:QuantityValue .

:TwinShipQuantityPower a owl:Class ;
    rdfs:label "TwinShip Quantity Power" ;
    rdfs:subClassOf qudt:Quantity ,
        [ a owl:Restriction ;
          owl:onProperty qudt:hasQuantityKind ;
          owl:allValuesFrom :TwinShipQuantityKindForPower ] ,
        [ a owl:Restriction ;
          owl:onProperty qudt:quantityValue ;
          owl:allValuesFrom :TwinShipQuantityValuePower ] .

:hasQuantityPower a owl:ObjectProperty ;
    rdfs:label "has quantity power" ;
    rdfs:comment "Relates a TwinShip physical object or process to a QUDT power quantity (watts, kilowatts, megawatts)." ;
    rdfs:subPropertyOf qudt:hasQuantity ;
    rdfs:range :TwinShipQuantityPower .

quantitykind:Power a :TwinShipQuantityKindForPower .
unit:KiloW a :TwinShipUnitForPower .
unit:MegaW a :TwinShipUnitForPower .


